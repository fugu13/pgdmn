<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="ticket_routing"
             name="TicketRouting"
             namespace="https://pgdmn.com/examples/routing">
    <inputData id="Priority" name="Priority">
        <variable name="Priority" typeRef="string"/>
    </inputData>
    <inputData id="CustomerTier" name="Customer Tier">
        <variable name="Customer Tier" typeRef="string"/>
    </inputData>
    <decision id="Queue" name="Queue">
        <variable name="Queue" typeRef="string"/>
        <informationRequirement>
            <requiredInput href="#Priority"/>
        </informationRequirement>
        <informationRequirement>
            <requiredInput href="#CustomerTier"/>
        </informationRequirement>
        <decisionTable hitPolicy="FIRST">
            <input>
                <inputExpression typeRef="string"><text>Priority</text></inputExpression>
            </input>
            <input>
                <inputExpression typeRef="string"><text>Customer Tier</text></inputExpression>
            </input>
            <output name="Queue" typeRef="string"/>
            <rule>
                <inputEntry><text>"critical"</text></inputEntry>
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>"pager"</text></outputEntry>
            </rule>
            <rule>
                <inputEntry><text>"high"</text></inputEntry>
                <inputEntry><text>"enterprise"</text></inputEntry>
                <outputEntry><text>"pager"</text></outputEntry>
            </rule>
            <rule>
                <inputEntry><text>"high"</text></inputEntry>
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>"tier-2"</text></outputEntry>
            </rule>
            <rule>
                <inputEntry><text>-</text></inputEntry>
                <inputEntry><text>"enterprise"</text></inputEntry>
                <outputEntry><text>"tier-2"</text></outputEntry>
            </rule>
            <rule>
                <inputEntry><text>-</text></inputEntry>
                <inputEntry><text>-</text></inputEntry>
                <outputEntry><text>"tier-1"</text></outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
